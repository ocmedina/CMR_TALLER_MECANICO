# Environment Configuration
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm_taller?schema=public"

# Authentication
JWT_SECRET="super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Frontend Public Base URL (para generación de enlaces en códigos QR)
FRONTEND_URL="http://localhost:3000"

# Cloudinary / Media (Opcional en desarrollo inicial)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
